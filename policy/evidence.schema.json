{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteWitness Evidence & Policy Schema",
  "definitions": {
    "EvidenceStatus": {
      "type": "string",
      "enum": ["MEASURED", "INFERRED", "NOT_MEASURED", "HUMAN_APPROVAL_REQUIRED"]
    },
    "LifecycleStage": {
      "type": "string",
      "enum": ["plan", "create", "verify", "package", "secure", "release", "configure", "monitor", "govern"]
    },
    "RouteInvariants": {
      "type": "object",
      "required": ["policyVersion", "policyName", "invariants"],
      "properties": {
        "policyVersion": { "type": "string" },
        "policyName": { "type": "string" },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "severity", "description", "enforcement"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "description": { "type": "string" },
              "requiresConnected": { "type": "boolean" },
              "enforcement": { "type": "string", "enum": ["BLOCK", "WARN"] }
            }
          }
        }
      }
    },
    "BenchmarkScenarios": {
      "type": "object",
      "required": ["policyVersion", "scenarios"],
      "properties": {
        "policyVersion": { "type": "string" },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "originId", "destinationId", "profileId", "invariantId", "requiresConnected"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "originId": { "type": "string" },
              "destinationId": { "type": "string" },
              "profileId": { "type": "string" },
              "activeBarrierIds": { "type": "array", "items": { "type": "string" } },
              "invariantId": { "type": "string" },
              "invariantDescription": { "type": "string" },
              "requiresConnected": { "type": "boolean" }
            }
          }
        }
      }
    },
    "ReleaseReceipt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "generatorVersion",
        "timestamp",
        "commitSha",
        "witnessSummary",
        "gateResults",
        "lifecycleEvidence",
        "checksumSha256",
        "isSyntheticData",
        "dataDisclaimer",
        "nonCertificationDisclosure"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "enum": ["1"] },
        "generatorVersion": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "pipelineUrl": { "type": "string" },
        "commitSha": { "type": "string", "minLength": 40, "maxLength": 40 },
        "imageDigest": { "type": "string" },
        "cloudRunRevision": { "type": "string" },
        "candidateUrl": { "type": "string" },
        "checksumSha256": { "type": "string" },
        "isSyntheticData": { "type": "boolean", "enum": [true] },
        "dataDisclaimer": { "type": "string" },
        "nonCertificationDisclosure": { "type": "string" }
      }
    }
  }
}
