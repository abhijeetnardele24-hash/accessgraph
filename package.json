{
  "name": "accessgraph",
  "private": true,
  "version": "1.0.0",
  "description": "Constraint-aware campus navigation that turns inaccessible routes into actionable repair priorities.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/run-benchmarks.ts",
    "evidence:check": "tsx scripts/check-evidence.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security-scan": "node scripts/security-scan.cjs",
    "witness:classify": "tsx route-witness/cli/index.ts classify",
    "witness:compare": "tsx route-witness/cli/index.ts compare",
    "witness:minimize": "tsx route-witness/cli/index.ts minimize",
    "witness:receipt": "tsx route-witness/cli/index.ts receipt",
    "verify:provenance": "tsx scripts/verify-provenance.ts",
    "verify:policy": "tsx scripts/verify-policy-integrity.ts",
    "verify:final": "tsx scripts/generate-final-evidence.ts"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.13.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
